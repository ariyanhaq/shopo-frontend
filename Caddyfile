:80 {
    root * /app/dist
    encode gzip

    # Proxy API calls directly to the Backend
    handle /api/* {
        reverse_proxy https://shopo-api.vidflix.live {
            header_up Host shopo-api.vidflix.live
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Single Page Application (SPA) routing fallback
    handle {
        try_files {path} /index.html
        file_server
    }
}
